APP_NAME=Stampippi
APP_ENV=local
APP_KEY=base64:8vK4x+y9Z1pQ2wE3rT4yU5iO6pA7sD8fG9hJ0kL1mN2=
APP_DEBUG=true
APP_DEV_TOOLS=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost:8000
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local uses SQLite by default; switch to pgsql for Neon / PostgreSQL
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=ep-example.ap-southeast-1.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=stampippi
# DB_USERNAME=neondb_owner
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
STAMP_IMAGE_DRIVER=public
# STAMP_IMAGE_DRIVER=laravel_cloud
# STAMP_IMAGE_CLOUD_DISK=
# STAMP_IMAGE_DRIVER=s3
# STAMP_IMAGE_DRIVER=database
# STAMP_IMAGE_PUBLIC_URL=https://cdn.example.com
# STAMP_IMAGE_S3_VISIBILITY=public
# STAMP_IMAGE_S3_SIGNED_URL=false
# STAMP_IMAGE_S3_SIGNED_TTL=60
QUEUE_CONNECTION=database
CACHE_STORE=database

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

